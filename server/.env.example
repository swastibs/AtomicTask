NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/atomictask
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
BCRYPT_ROUNDS=12
# Comma-separated, exact frontend origins; never use * with credentialed cookies.
CORS_ALLOWED_ORIGINS=https://app.example.com
# Set only when the app is behind a trusted reverse proxy.
TRUST_PROXY=true
# Use "none" only when frontend and API are genuinely cross-site; HTTPS is then mandatory.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
